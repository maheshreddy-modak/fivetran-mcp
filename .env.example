# Server-side settings for the containerised fivetran-mcp (streamable-http mode).
#
# Do NOT set FIVETRAN_API_KEY / FIVETRAN_API_SECRET here: in HTTP mode the server
# refuses to start if they are present. Each client sends its own credentials as
# an "Authorization: Basic <base64(key:secret)>" header instead.

# One of: read, read/write, read/write/delete (server-wide ceiling for all clients)
FIVETRAN_SCOPE=read/write

# Deny credential-minting endpoints even within the scope above.
DISALLOWED_ACTIONS=system-keys:read,users:read:get_user_api_key,users:read:list_api_keys,users:write:create_user_api_key,users:write:rotate_user_api_key,users:delete:delete_user_api_keys

# Host port published by docker-compose (the container always listens on 8000).
# The port in MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS below must match this value.
MCP_PORT=8099

# DNS-rebinding protection. Must list every host:port clients use to reach the server.
MCP_ALLOWED_HOSTS=localhost:8099,127.0.0.1:8099,10.50.17.193:8099,forgeai-dev.modak.com:8099,forgeai-dev.modak.com
MCP_ALLOWED_ORIGINS=http://localhost:8099,http://127.0.0.1:8099,http://forgeai-dev.modak.com:8099,http://forgeai-qa.modak.com,http://forgeai-qa-1.modak.com

# Set to true if your client can only send "Authorization: Bearer <token>". The token must be
# base64(api_key:api_secret); the server forwards it to Fivetran as "Basic <token>".
FIVETRAN_BEARER_AS_BASIC=true
